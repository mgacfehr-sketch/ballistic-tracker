{
  "_comment": "Gate 0 golden fixtures for js/simple-true.js — the one-observation 'where did it hit?' path (Contract v2.5 §2.3). Complements tests/test-simple-true.js (which checks round-trip CORRECTNESS: a planted fps error must be recovered) by pinning exact recorded outputs for fixed inputs, so any future behavioral drift in the payoff wording, confidence, or honesty-guard boundaries is caught even if the recovered value stays numerically close. Only the pure top section (simpleToMOA through simpleTruePayoffCopy) is covered — the SimpleTrue DOM flow at the bottom of the file is browser-only and out of scope.",
  "shared": {
    "ENV": { "tempF": 59, "pressureInHg": 29.92, "humidity": 50, "source": "default" },
    "CLAIMED": { "muzzleVelocity": 2960, "bc": 0.315, "dragModel": "G7", "bulletWeight": 143, "zeroRange": 100, "scopeHeight": 1.8 }
  },
  "unitConversionCases": [
    { "name": "simpleToMOA: 1 MIL -> MOA", "fn": "simpleToMOA", "args": [1, "MIL", 600], "expect": 3.43775 },
    { "name": "simpleToMOA: 6.28in at 600yd -> ~1 MOA", "fn": "simpleToMOA", "args": [6.28, "IN", 600], "expect": 0.999681630054123 },
    { "name": "simpleToMOA: MOA units pass through unchanged", "fn": "simpleToMOA", "args": [2.5, "MOA", 600], "expect": 2.5 },
    { "name": "simpleToMOA: unrecognized units string also passes through unchanged (falls to the else branch)", "fn": "simpleToMOA", "args": [2.5, "XYZ", 600], "expect": 2.5 },
    { "name": "simpleFromMOA: MOA -> MIL", "fn": "simpleFromMOA", "args": [3.43775, "MIL", 600], "expect": 1 },
    { "name": "simpleFromMOA: MOA -> inches at 600yd", "fn": "simpleFromMOA", "args": [1.0, "IN", 600], "expect": 6.282 },
    { "name": "simpleFromMOA: MOA units pass through unchanged", "fn": "simpleFromMOA", "args": [2.5, "MOA", 600], "expect": 2.5 }
  ],
  "comeUpAtCases": [
    { "name": "simpleComeUpAt: 600yd lands exactly on a 10yd table step", "args": ["$CLAIMED", "$ENV", 600], "expect": 10.8613 },
    { "name": "simpleComeUpAt: 587yd interpolates between table steps", "args": ["$CLAIMED", "$ENV", 587], "expect": 10.48801 },
    { "name": "simpleComeUpAt: null env falls back to the same std-atmosphere default", "args": ["$CLAIMED", null, 600], "expect": 10.8613 },
    { "name": "simpleComeUpAt: 0F literal survives the falsy-zero guard (becomes 0.001F, not silently std atmo)", "args": ["$CLAIMED", { "tempF": 0, "pressureInHg": 29.92, "humidity": 50 }, 600], "expect": 11.1939 },
    { "name": "simpleComeUpAt: range far beyond a normal working table still resolves (maxRange auto-extends to rangeYds+50)", "args": ["$CLAIMED", "$ENV", 2000], "expect": 98.0266 },
    { "name": "simpleComeUpAt: 0yd -> 0 (muzzle row is special-cased to zero come-up)", "args": ["$CLAIMED", "$ENV", 0], "expect": 0 },
    { "name": "simpleComeUpAt: 10yd, still below the zero — a real (non-guarded) near-muzzle value", "args": ["$CLAIMED", "$ENV", 10], "expect": 13.5909 }
  ],
