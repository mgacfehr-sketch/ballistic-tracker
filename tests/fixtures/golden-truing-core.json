    { "name": "truingConfidence: 24 shots/4 groups, everything measured and tight -> High (5)", "fn": "truingConfidence", "args": [{ "shotCount": 24, "groupCount": 4, "mvMeasuredPct": 1, "windLoggedPct": 1, "groupSpreadMOA": 0.2, "envSource": "measured", "zeroConfirmed": true, "trackingVerified": true, "supersonicPct": 0.95, "correctionType": "bc", "mode": "full" }], "expect": { "segments": 5, "word": "High", "capNotes": [] } },
    { "name": "truingConfidence: 2 shots, no wind logged, default env -> Thin (1), wind-hedge note", "fn": "truingConfidence", "args": [{ "shotCount": 2, "groupCount": 1, "mvMeasuredPct": 0, "windLoggedPct": 0, "envSource": "default", "zeroConfirmed": true, "trackingVerified": true, "correctionType": "mv", "mode": "full" }], "expect": { "segments": 1, "word": "Thin", "capNotes": ["Wind was logged on under half these shots — deflection may hide in the vertical."] } },
    { "name": "truingConfidence: otherwise-High inputs but Quick mode caps at Moderate (3)", "fn": "truingConfidence", "args": [{ "shotCount": 20, "groupCount": 3, "mvMeasuredPct": 1, "windLoggedPct": 1, "groupSpreadMOA": 0.1, "envSource": "measured", "zeroConfirmed": true, "trackingVerified": true, "correctionType": "mv", "mode": "quick" }], "expect": { "segments": 3, "word": "Moderate", "capNotes": ["Quick true assumes no wind and your saved MV — good for a rough correction."] } },
    { "name": "truingConfidence: zero not confirmed caps at Thin (2) regardless of sample size (C22: nothing trues without a confirmed zero)", "fn": "truingConfidence", "args": [{ "shotCount": 20, "groupCount": 3, "mvMeasuredPct": 1, "windLoggedPct": 1, "groupSpreadMOA": 0.1, "envSource": "measured", "zeroConfirmed": false, "trackingVerified": true, "correctionType": "mv", "mode": "full" }], "expect": { "segments": 2, "word": "Thin", "capNotes": ["Zero isn't confirmed — confirm it before trusting any truing."] } },
    { "name": "truingConfidence: BC correction trued below 85% of supersonic range caps at Moderate (3), extrapolation warning", "fn": "truingConfidence", "args": [{ "shotCount": 20, "groupCount": 3, "mvMeasuredPct": 1, "windLoggedPct": 1, "groupSpreadMOA": 0.1, "envSource": "measured", "zeroConfirmed": true, "trackingVerified": true, "supersonicPct": 0.6, "correctionType": "bc", "mode": "full" }], "expect": { "segments": 3, "word": "Moderate", "capNotes": ["Trued at 60% of supersonic — a drag correction from here is extrapolated."] } },

    { "name": "deviceCompensation: scope tracks true (factor 1.0) -> identity passthrough, no correction needed", "fn": "deviceCompensation", "args": ["$SMK308", "$ENV", 1.0, { "fromYd": 200, "toYd": 1000 }], "expect": { "bcOut": 0.243, "mvOut": 2650, "sweetSpot": { "fromYd": 200, "toYd": 1000, "maxErrMOA": 0 }, "errorCurve": [], "identity": true } },
    {
      "name": "deviceCompensation: scope tracks 4% short -> fitted BC/MV pair compensates through the whole working range",
      "fn": "deviceCompensation",
