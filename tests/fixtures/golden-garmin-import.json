{
  "_comment": "Gate 0 golden fixtures for js/garmin-import.js. Complements tests/test-garmin-import.js (which checks individual fields against the real 'TEST SHOTVIEW SHEET.xlsx' sample with tolerances) by (a) pinning the low-level pure helpers in isolation, which the existing suite only exercises indirectly, and (b) locking the FULL returned session object(s) for the real sample data and several synthetic edge cases via exact deep equality, catching drift in fields (warnings[], reported{}, source, name, date) the existing per-field checks don't cross-check together. Args/expect values starting with '@' are resolved by the test harness to real files under tests/fixtures/ (shotview-sheets.json, shotview-single.csv) rather than duplicating that data here — see tests/test-golden-garmin-import.js.",
  "pureFunctionCases": [
    { "name": "cleanCellText: null -> empty string", "fn": "cleanCellText", "args": [null], "expect": "" },
    { "name": "cleanCellText: number coerces to string", "fn": "cleanCellText", "args": [42], "expect": "42" },
    { "name": "cleanCellText: collapses runs of whitespace and trims", "fn": "cleanCellText", "args": ["  hello   world  "], "expect": "hello world" },
    { "name": "cleanCellText: exotic Unicode spaces (U+202F, U+00A0) become plain spaces", "fn": "cleanCellText", "args": ["3:09 32 PM"], "expect": "3:09 32 PM" },

    { "name": "isShotNumberCell: whole number string -> true", "fn": "isShotNumberCell", "args": ["3"], "expect": true },
    { "name": "isShotNumberCell: text label -> false", "fn": "isShotNumberCell", "args": ["AVERAGE SPEED"], "expect": false },
    { "name": "isShotNumberCell: empty -> false", "fn": "isShotNumberCell", "args": [""], "expect": false },
    { "name": "isShotNumberCell: decimal (a velocity, not a shot number) -> false", "fn": "isShotNumberCell", "args": ["2743.4"], "expect": false },
    { "name": "isShotNumberCell: null -> false", "fn": "isShotNumberCell", "args": [null], "expect": false },

    { "name": "findHeaderRow: full header with all optional columns", "fn": "findHeaderRow", "args": [[["junk"], ["#", "Speed (FPS)", "Time", "Clean Bore", "Cold Bore", "Notes"]]], "expect": { "rowIndex": 1, "cols": { "shot": 0, "speed": 1, "time": 2, "cleanBore": 3, "coldBore": 4, "notes": 5 } } },
    { "name": "findHeaderRow: no matching row -> null", "fn": "findHeaderRow", "args": [[["a", "b"], ["1", "2"]]], "expect": null },
    { "name": "findHeaderRow: empty rows -> null", "fn": "findHeaderRow", "args": [[]], "expect": null },
    { "name": "findHeaderRow: alternate 'Shot #' label, no optional columns", "fn": "findHeaderRow", "args": [[["Shot #", "Speed"]]], "expect": { "rowIndex": 0, "cols": { "shot": 0, "speed": 1, "time": -1, "cleanBore": -1, "coldBore": -1, "notes": -1 } } },

    { "name": "parseSheetNameDate: valid ShotView sheet name", "fn": "parseSheetNameDate", "args": ["Rifle sessio_2026-06-26_15-07_1"], "expect": "2026-06-26T15:07" },
    { "name": "parseSheetNameDate: no date pattern -> null", "fn": "parseSheetNameDate", "args": ["no date here"], "expect": null },
    { "name": "parseSheetNameDate: empty -> null", "fn": "parseSheetNameDate", "args": [""], "expect": null },

    { "name": "parseSummaryDate: valid ShotView DATE summary text", "fn": "parseSummaryDate", "args": ["June 26, 2026 at 3:07 PM"], "expect": "2026-06-26T15:07" },
    { "name": "parseSummaryDate: unparseable -> null", "fn": "parseSummaryDate", "args": ["not a date"], "expect": null },

    { "name": "splitCsvLine: plain comma-separated", "fn": "splitCsvLine", "args": ["a,b,c"], "expect": ["a", "b", "c"] },
    { "name": "splitCsvLine: quoted cell containing a comma", "fn": "splitCsvLine", "args": ["a,\"b,c\",d"], "expect": ["a", "b,c", "d"] },
    { "name": "splitCsvLine: doubled-quote escape inside a quoted cell", "fn": "splitCsvLine", "args": ["a,\"he said \"\"hi\"\"\",c"], "expect": ["a", "he said \"hi\"", "c"] },
    { "name": "splitCsvLine: empty line -> one empty cell", "fn": "splitCsvLine", "args": [""], "expect": [""] },
    { "name": "splitCsvLine: trailing comma -> trailing empty cell", "fn": "splitCsvLine", "args": ["a,b,"], "expect": ["a", "b", ""] }
  ],
  "sessionCases": [
    {
      "name": "parseShotViewSheets: real 3-sheet workbook, session 1 (8 shots) — full object snapshot",
      "fn": "parseShotViewSheets",
      "args": ["@shotview-sheets"],
      "pick": 0,
      "expect": { "source": "garmin_xlsx", "name": "Rifle sessio_2026-06-26_15-07_1", "date": "2026-06-26T15:07", "shots": [{ "shot": 1, "fps": 2691.5, "time": "3:09:32 PM" }, { "shot": 2, "fps": 2800.3, "time": "3:10:27 PM" }, { "shot": 3, "fps": 2769.3, "time": "3:11:23 PM" }, { "shot": 4, "fps": 2723.8, "time": "3:11:45 PM" }, { "shot": 5, "fps": 2759.6, "time": "3:12:07 PM" }, { "shot": 6, "fps": 2738.9, "time": "3:12:51 PM" }, { "shot": 7, "fps": 2731.3, "time": "3:13:14 PM" }, { "shot": 8, "fps": 2732.4, "time": "3:13:32 PM" }], "reported": { "avg": 2743.4, "sd": 30.7, "es": 108.8 }, "warnings": [] }
    },
    {
      "name": "parseShotViewSheets: real 3-sheet workbook, session 3 (7 shots) — full object snapshot",
      "fn": "parseShotViewSheets",
      "args": ["@shotview-sheets"],
      "pick": 2,
      "expect": { "source": "garmin_xlsx", "name": "Rifle sessio_2026-06-26_14-39_3", "date": "2026-06-26T14:39", "shots": [{ "shot": 1, "fps": 2934.3, "time": "2:39:55 PM" }, { "shot": 2, "fps": 2957.4, "time": "2:41:19 PM" }, { "shot": 3, "fps": 2947.2, "time": "2:41:41 PM" }, { "shot": 4, "fps": 2956.7, "time": "2:42:07 PM" }, { "shot": 5, "fps": 3004.2, "time": "2:46:45 PM" }, { "shot": 6, "fps": 2957.7, "time": "2:47:14 PM" }, { "shot": 7, "fps": 2957.6, "time": "2:47:57 PM" }], "reported": { "avg": 2959.3, "sd": 20, "es": 69.8 }, "warnings": [] }
    },
    {
      "name": "parseShotViewCSV: real single-session CSV — full object snapshot",
      "fn": "parseShotViewCSV",
      "args": ["@shotview-csv", "shotview-single.csv"],
      "expect": { "source": "garmin_csv", "name": "shotview-single.csv", "date": "2026-06-26T14:48", "shots": [{ "shot": 1, "fps": 2994.2, "time": "2:51:29 PM" }, { "shot": 2, "fps": 2971.3, "time": "2:57:40 PM" }, { "shot": 3, "fps": 2960.3, "time": "2:58:53 PM" }, { "shot": 4, "fps": 2972.1, "time": "2:59:58 PM" }, { "shot": 5, "fps": 2974.1, "time": "3:01:47 PM" }, { "shot": 6, "fps": 2969.2, "time": "3:03:22 PM" }, { "shot": 7, "fps": 2949.1, "time": "3:03:43 PM" }, { "shot": 8, "fps": 2947.4, "time": "3:04:00 PM" }, { "shot": 9, "fps": 3019.8, "time": "3:05:33 PM" }, { "shot": 10, "fps": 2980, "time": "3:06:08 PM" }, { "shot": 11, "fps": 3009.4, "time": "3:06:33 PM" }], "reported": { "avg": 2977, "sd": 21.8, "es": 72.4 }, "warnings": [] }
    },
    {
      "name": "parseSheetRows: header shifted to row 4 by leading junk rows — found by content, not position",
      "fn": "parseSheetRows",
      "args": ["@shifted-header", { "name": "shifted" }],
      "expect": { "source": "shotview", "name": "shifted", "date": "2026-06-26T15:07", "shots": [{ "shot": 1, "fps": 2691.5, "time": "3:09:32 PM" }, { "shot": 2, "fps": 2800.3, "time": "3:10:27 PM" }, { "shot": 3, "fps": 2769.3, "time": "3:11:23 PM" }, { "shot": 4, "fps": 2723.8, "time": "3:11:45 PM" }, { "shot": 5, "fps": 2759.6, "time": "3:12:07 PM" }, { "shot": 6, "fps": 2738.9, "time": "3:12:51 PM" }, { "shot": 7, "fps": 2731.3, "time": "3:13:14 PM" }, { "shot": 8, "fps": 2732.4, "time": "3:13:32 PM" }], "reported": { "avg": 2743.4, "sd": 30.7, "es": 108.8 }, "warnings": [] }
    },
    {
      "name": "parseSheetRows: unparseable speed cell is skipped with a warning, not a crash or a silent guess",
      "fn": "parseSheetRows",
      "args": [[["#", "Speed (FPS)", "Time"], ["1", "2800.1", "3:09:32 PM"], ["2", "ERROR", "3:10:00 PM"]], {}],
      "expect": { "source": "shotview", "name": null, "date": null, "shots": [{ "shot": 1, "fps": 2800.1, "time": "3:09:32 PM" }], "reported": { "avg": null, "sd": null, "es": null }, "warnings": ["Shot 2 skipped: speed \"ERROR\" is not a number."] }
    },
    {
      "name": "parseShotViewSheets: one unparseable sheet + one good sheet -> good session returned, bad sheet's failure appended as a warning (evidence preserved, never silently dropped)",
      "fn": "parseShotViewSheets",
      "args": ["@mixed-sheets"],
      "expect": [{ "source": "garmin_xlsx", "name": "Rifle sessio_2026-06-26_15-07_1", "date": "2026-06-26T15:07", "shots": [{ "shot": 1, "fps": 2691.5, "time": "3:09:32 PM" }, { "shot": 2, "fps": 2800.3, "time": "3:10:27 PM" }, { "shot": 3, "fps": 2769.3, "time": "3:11:23 PM" }, { "shot": 4, "fps": 2723.8, "time": "3:11:45 PM" }, { "shot": 5, "fps": 2759.6, "time": "3:12:07 PM" }, { "shot": 6, "fps": 2738.9, "time": "3:12:51 PM" }, { "shot": 7, "fps": 2731.3, "time": "3:13:14 PM" }, { "shot": 8, "fps": 2732.4, "time": "3:13:32 PM" }], "reported": { "avg": 2743.4, "sd": 30.7, "es": 108.8 }, "warnings": ["Sheet \"junk\": Could not find a ShotView header row (a row with \"#\" and \"Speed\" columns). This does not look like a Garmin ShotView export."] }]
    }
  ],
  "throwCases": [
    { "name": "parseSheetRows: empty rows array throws", "fn": "parseSheetRows", "args": [[], {}], "throws": "expected a Garmin ShotView export" },
    { "name": "parseShotViewCSV: empty text throws", "fn": "parseShotViewCSV", "args": ["   "], "throws": "empty" },
    { "name": "parseSheetRows: header found but zero shot rows throws", "fn": "parseSheetRows", "args": [[["#", "Speed (FPS)", "Time"], ["AVERAGE SPEED", "2743.4"]], {}], "throws": "no shot rows" },
    { "name": "parseShotViewSheets: no sheets throws", "fn": "parseShotViewSheets", "args": [[]], "throws": "no sheets" },
    { "name": "parseShotViewSheets: every sheet unparseable throws, includes per-sheet reasons", "fn": "parseShotViewSheets", "args": [[{ "name": "x", "rows": [["a", "b"], ["1", "2"]] }]], "throws": "No sheet in this workbook" },
    { "name": "parseShotViewCSV: random non-ShotView CSV throws", "fn": "parseShotViewCSV", "args": ["name,age\nbob,42\nsue,39\n"], "throws": "does not look like a Garmin ShotView export" }
  ]
}
