{
  "_comment": "Gate 0 golden fixtures for js/calculations.js. Each case calls calc[fn](...args) and the result must deep-equal `expect` exactly, or (for error cases) calc[fn](...args) must throw with a message containing `throws`. Inputs are fixed, documented pixel/inch scenarios — not randomly generated — so a human can sanity-check them against the doctrine in CLAUDE.md (pixelsPerInch=120 is the fixed ArUco calibration constant; impacts are hole centers, no bullet-diameter subtraction).",
  "shared": {
    "impacts5": [
      { "x": 1000, "y": 800 },
      { "x": 1015, "y": 812 },
      { "x": 990, "y": 795 },
      { "x": 1008, "y": 820 },
      { "x": 995, "y": 785 }
    ],
    "poa": { "x": 1000, "y": 800 },
    "ppi": 120,
    "dist": 100
  },
  "cases": [
    { "name": "inchesToMOA: 1.047in @ 100yd = 1.0 MOA", "fn": "inchesToMOA", "args": [1.047, 100], "expect": 1.0000000000000002 },
    { "name": "moaToInches: 1.0 MOA @ 1000yd", "fn": "moaToInches", "args": [1.0, 1000], "expect": 10.469999999999999 },
    { "name": "inchesToMOA: zero distance throws", "fn": "inchesToMOA", "args": [1.0, 0], "throws": "Distance must be positive" },
    { "name": "moaToInches: negative distance throws", "fn": "moaToInches", "args": [1.0, -5], "throws": "Distance must be positive" },
    { "name": "pixelDistance: 3-4-5 triangle", "fn": "pixelDistance", "args": [{ "x": 0, "y": 0 }, { "x": 3, "y": 4 }], "expect": 5 },
    { "name": "pixelsToInches: 120px @ 120ppi = 1in", "fn": "pixelsToInches", "args": [120, 120], "expect": 1 },
    { "name": "pixelsToInches: zero ppi throws", "fn": "pixelsToInches", "args": [100, 0], "throws": "pixelsPerInch must be positive" },
    { "name": "centerToCenter: normal subtraction", "fn": "centerToCenter", "args": [1.0, 0.308], "expect": 0.692 },
    { "name": "centerToCenter: clamped at zero (edge < diameter)", "fn": "centerToCenter", "args": [0.1, 0.308], "expect": 0 },
    { "name": "calculateCentroid: empty throws", "fn": "calculateCentroid", "args": [[]], "throws": "No impacts provided" },
    { "name": "calculateCentroid: 5-shot group", "fn": "calculateCentroid", "args": ["$impacts5"], "expect": { "x": 1001.6, "y": 802.4 } },
    { "name": "calculateGroupSize: 5-shot group", "fn": "calculateGroupSize", "args": ["$impacts5", "$ppi"], "expect": { "inches": 0.31113591170990784, "pair": [3, 4] } },
    { "name": "calculateGroupSize: single shot -> zero", "fn": "calculateGroupSize", "args": [["$impacts5.0"], "$ppi"], "expect": { "inches": 0, "pair": [0, 0] } },
    { "name": "calculateGroupSize: empty -> zero", "fn": "calculateGroupSize", "args": [[], "$ppi"], "expect": { "inches": 0, "pair": [0, 0] } },
    { "name": "calculateMeanRadius: 5-shot group", "fn": "calculateMeanRadius", "args": ["$impacts5", "$ppi"], "expect": 0.11744154633461051 },
    { "name": "calculateMeanRadius: single shot -> zero", "fn": "calculateMeanRadius", "args": [["$impacts5.0"], "$ppi"], "expect": 0 },
    { "name": "calculateVerticalSpread: 5-shot group", "fn": "calculateVerticalSpread", "args": ["$impacts5", "$ppi"], "expect": 0.2916666666666667 },
    { "name": "calculateHorizontalSpread: 5-shot group", "fn": "calculateHorizontalSpread", "args": ["$impacts5", "$ppi"], "expect": 0.20833333333333334 },
    { "name": "calculatePOAOffset: 5-shot group", "fn": "calculatePOAOffset", "args": ["$poa", "$impacts5", "$ppi"], "expect": { "elevationInches": -0.01999999999999981, "windageInches": 0.013333333333333523 } },
    { "name": "calculatePOAOffset: empty impacts -> zero", "fn": "calculatePOAOffset", "args": ["$poa", [], "$ppi"], "expect": { "elevationInches": 0, "windageInches": 0 } },
    { "name": "calculateATZ: from 5-shot POA offset", "fn": "calculateATZ", "args": [{ "elevationInches": -0.01999999999999981, "windageInches": 0.013333333333333523 }, "$dist"], "expect": { "elevationMOA": 0.019102196752626373, "windageMOA": 0.012734797835084551, "elevationDir": "Up", "windageDir": "Left" } },
    { "name": "calculateCEP: 5-shot group", "fn": "calculateCEP", "args": ["$impacts5", "$ppi"], "expect": 0.13736609641554365 },
    { "name": "calculateRadialSD: 5-shot group", "fn": "calculateRadialSD", "args": ["$impacts5", "$ppi"], "expect": 0.04906611044840961 },
    { "name": "calculateVerticalSD: 5-shot group", "fn": "calculateVerticalSD", "args": ["$impacts5", "$ppi"], "expect": 0.10309111396128058 },
    { "name": "calculateHorizontalSD: 5-shot group", "fn": "calculateHorizontalSD", "args": ["$impacts5", "$ppi"], "expect": 0.07464731892186259 },
    { "name": "calculateMeanElevation: 5-shot group", "fn": "calculateMeanElevation", "args": ["$impacts5", "$poa", "$ppi"], "expect": -0.02 },
    { "name": "calculateMeanElevation: empty -> zero", "fn": "calculateMeanElevation", "args": [[], "$poa", "$ppi"], "expect": 0 },
    { "name": "calculateMeanWindage: 5-shot group", "fn": "calculateMeanWindage", "args": ["$impacts5", "$poa", "$ppi"], "expect": 0.013333333333333334 },
    { "name": "calculateShotOffset: shot on POA -> all zero, High/Right ties", "fn": "calculateShotOffset", "args": ["$impacts5.0", "$poa", "$ppi", "$dist"], "expect": { "verticalInches": 0, "verticalMOA": 0, "verticalDir": "High", "horizontalInches": 0, "horizontalMOA": 0, "horizontalDir": "Right", "radialInches": 0, "radialMOA": 0 } },
    { "name": "calculateShotOffset: null shot -> null", "fn": "calculateShotOffset", "args": [null, "$poa", "$ppi", "$dist"], "expect": null },
    { "name": "calculateShotOffset: zero ppi -> null", "fn": "calculateShotOffset", "args": ["$impacts5.0", "$poa", 0, "$dist"], "expect": null },
    { "name": "zeroVerdict: both axes within 0.25 MOA tolerance -> confirmed", "fn": "zeroVerdict", "args": [{ "elevationMOA": 0.1, "windageMOA": 0.15, "elevationDir": "Up", "windageDir": "Left" }, 0.25, 0.25], "expect": { "confirmed": true, "elevClicks": 0, "elevDir": "Up", "windClicks": 1, "windDir": "Left" } },
    { "name": "zeroVerdict: elevation exceeds tolerance -> not confirmed", "fn": "zeroVerdict", "args": [{ "elevationMOA": 0.6, "windageMOA": 0.2, "elevationDir": "Down", "windageDir": "Right" }, 0.25, 0.25], "expect": { "confirmed": false, "elevClicks": 2, "elevDir": "Down", "windClicks": 1, "windDir": "Right" } },
    { "name": "scopeTrackingAnalysis: tracks true, no cant", "fn": "scopeTrackingAnalysis", "args": [10, 100, 10.47, 0.05], "expect": { "expectedInches": 10.47, "actualInches": 10.47, "factor": 1, "errorPct": 0, "cantWarn": false } },
    { "name": "scopeTrackingAnalysis: tracks true but lateral drift trips cant warning", "fn": "scopeTrackingAnalysis", "args": [10, 100, 10.47, 0.3], "expect": { "expectedInches": 10.47, "actualInches": 10.47, "factor": 1, "errorPct": 0, "cantWarn": true } },
    { "name": "scopeTrackingAnalysis: tracks 4% short, no drift", "fn": "scopeTrackingAnalysis", "args": [10, 100, 10.05, 0], "expect": { "expectedInches": 10.47, "actualInches": 10.05, "factor": 0.9599, "errorPct": -4.0115, "cantWarn": false } },
    { "name": "applyScopeCorrection: 4% short factor increases dial", "fn": "applyScopeCorrection", "args": [4.0, 0.96], "expect": 4.166666666666667 },
    { "name": "applyScopeCorrection: invalid factor passes through unchanged", "fn": "applyScopeCorrection", "args": [4.0, 0], "expect": 4 },
    { "name": "round4: rounds to 4 decimal places", "fn": "round4", "args": [1.23456789], "expect": 1.2346 },
    {
      "name": "calculateSession: full 5-shot composite result",
      "fn": "calculateSession",
      "args": [{ "impacts": "$impacts5", "poa": "$poa", "pixelsPerInch": "$ppi", "bulletDiameter": 0.308, "distanceYards": "$dist" }],
      "expect": {
        "shotCount": 5,
        "distanceYards": 100,
        "groupSizeInches": 0.3111,
        "groupSizeMOA": 0.2972,
        "groupSizePair": [3, 4],
        "meanRadiusInches": 0.1174,
        "meanRadiusMOA": 0.1122,
        "verticalSpreadInches": 0.2917,
        "verticalSpreadMOA": 0.2786,
        "horizontalSpreadInches": 0.2083,
        "horizontalSpreadMOA": 0.199,
        "elevationOffsetInches": -0.02,
        "elevationOffsetMOA": 0.0191,
        "windageOffsetInches": 0.0133,
        "windageOffsetMOA": 0.0127,
        "atzElevationMOA": 0.0191,
        "atzElevationDir": "Up",
        "atzWindageMOA": 0.0127,
        "atzWindageDir": "Left",
        "cepInches": 0.1374,
        "cepMOA": 0.1312,
        "radialSDInches": 0.0491,
        "radialSDMOA": 0.0469,
        "verticalSDInches": 0.1031,
        "verticalSDMOA": 0.0985,
        "horizontalSDInches": 0.0746,
        "horizontalSDMOA": 0.0713,
        "meanElevationInches": -0.02,
        "meanElevationMOA": 0.0191,
        "meanWindageInches": 0.0133,
        "meanWindageMOA": 0.0127,
        "centroid": { "x": 1001.6, "y": 802.4 }
      }
    },
    { "name": "calculateSession: no impacts throws", "fn": "calculateSession", "args": [{ "impacts": [], "poa": "$poa", "pixelsPerInch": "$ppi", "bulletDiameter": 0.308, "distanceYards": "$dist" }], "throws": "No impacts to calculate" }
  ]
}
