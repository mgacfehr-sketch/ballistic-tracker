          { "rangeYards": 400, "dropInches": -29.7451, "dropMOA": -7.1025, "comeUpMOA": 7.1025, "windDriftInches": -8.9305, "windDriftMOA": -2.1324, "velocityFps": 2169, "energyFtLbs": 1755, "timeOfFlightSec": 0.4955, "machNumber": 1.9429 },
          { "rangeYards": 500, "dropInches": -53.377, "dropMOA": -10.1962, "comeUpMOA": 10.1962, "windDriftInches": -14.4736, "windDriftMOA": -2.7648, "velocityFps": 2039, "energyFtLbs": 1551, "timeOfFlightSec": 0.638, "machNumber": 1.8263 }
