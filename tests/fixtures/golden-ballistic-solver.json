{
  "_comment": "Gate 0 golden fixtures for js/ballistic-solver.js's pure solver section (interpolateCd through computeTrajectory — NOT the BallisticSolverManager UI class, which is DOM-dependent and out of scope for engine fixtures). IMPORTANT: this engine has an undeclared runtime dependency on js/calculations.js's round4() and inchesToMOA() being present as bare globals (true in the browser, where index.html loads calculations.js before ballistic-solver.js as plain <script> tags sharing one global scope). See tests/test-golden-ballistic-solver.js for how the harness replicates that, and docs/canon/interface-contracts/ballistic-solver.md for the finding.",
  "cases": [
    { "name": "interpolateCd (G1): exact table point at Mach 0.50", "fn": "interpolateCd", "args": ["$G1_DRAG_TABLE", 0.5], "expect": 0.2032 },
    { "name": "interpolateCd (G1): interpolated between 0.60 and 0.65", "fn": "interpolateCd", "args": ["$G1_DRAG_TABLE", 0.62], "expect": 0.20543999999999998 },
    { "name": "interpolateCd (G1): below table range clamps to first entry", "fn": "interpolateCd", "args": ["$G1_DRAG_TABLE", -1], "expect": 0.2629 },
    { "name": "interpolateCd (G1): above table range clamps to last entry", "fn": "interpolateCd", "args": ["$G1_DRAG_TABLE", 10], "expect": 0.2261 },
    { "name": "interpolateCd (G7): exact table point at Mach 1.00 (transonic peak)", "fn": "interpolateCd", "args": ["$G7_DRAG_TABLE", 1.0], "expect": 0.3803 },

    { "name": "calculateSpeedOfSound: standard temp (59F)", "fn": "calculateSpeedOfSound", "args": [59], "expect": 1116.4499224539381 },
    { "name": "calculateSpeedOfSound: cold (0F)", "fn": "calculateSpeedOfSound", "args": [0], "expect": 1051.0339963137703 },
    { "name": "calculateSpeedOfSound: hot (100F)", "fn": "calculateSpeedOfSound", "args": [100], "expect": 1159.7374923388027 },

    { "name": "calculateAirDensityRatio: standard atmosphere -> ratio 1.0", "fn": "calculateAirDensityRatio", "args": [59, 29.92, 0], "expect": 1 },
    { "name": "calculateAirDensityRatio: hot + humid -> thinner air", "fn": "calculateAirDensityRatio", "args": [95, 29.92, 80], "expect": 0.932525586253503 },
    { "name": "calculateAirDensityRatio: cool + altitude pressure + some humidity", "fn": "calculateAirDensityRatio", "args": [50, 24.90, 20], "expect": 0.8467622097665947 },

    { "name": "estimatePressureAtAltitude: sea level", "fn": "estimatePressureAtAltitude", "args": [0], "expect": 29.92 },
    { "name": "estimatePressureAtAltitude: 5000 ft", "fn": "estimatePressureAtAltitude", "args": [5000], "expect": 24.89484912260263 },
    { "name": "estimatePressureAtAltitude: 8000 ft", "fn": "estimatePressureAtAltitude", "args": [8000], "expect": 22.223990221524723 },

    { "name": "windComponentsFromClock: 3 o'clock (full crosswind from right) 10mph", "fn": "windComponentsFromClock", "args": [3, 10], "expect": { "windVxFps": -8.980743193747256e-16, "windVzFps": -14.666666666666666 } },
    { "name": "windComponentsFromClock: 12 o'clock (full headwind) 10mph", "fn": "windComponentsFromClock", "args": [12, 10], "expect": { "windVxFps": -14.666666666666666, "windVzFps": 0 } },
    { "name": "windComponentsFromClock: 6 o'clock (full tailwind) 10mph", "fn": "windComponentsFromClock", "args": [6, 10], "expect": { "windVxFps": 14.666666666666666, "windVzFps": -1.7961486387494512e-15 } },
    { "name": "windComponentsFromClock: 9 o'clock (full crosswind from left) 10mph", "fn": "windComponentsFromClock", "args": [9, 10], "expect": { "windVxFps": 2.694222958124177e-15, "windVzFps": 14.666666666666666 } },

    { "name": "solverDerivatives: normal supersonic state (V >= 1 fps)", "fn": "solverDerivatives", "args": [[0, 0, 2700, 5, 0, 0], -5, 0, "$speedOfSoundStd", 0.462, "$G1_DRAG_TABLE", 1], "expect": [2700, 5, -1215.7106624327407, -34.42120464405313, 0, 0] },
    { "name": "solverDerivatives: sub-1fps velocity short-circuits to gravity-only", "fn": "solverDerivatives", "args": [[100, 50, 0.5, 0.2, 0, 0], 0, 0, "$speedOfSoundStd", 0.462, "$G1_DRAG_TABLE", 1], "expect": [0.5, 0.2, 0, -32.17405, 0, 0] },

    { "name": "rk4Step: one 0.5ms step from muzzle (2700fps, 10mph 3'oclock wind)", "fn": "rk4Step", "args": [[0, 0, 2700, 0, 0, 0], 0.0005, -8.980743193747256e-16, -14.666666666666666, "$speedOfSoundStd", 0.462, "$G1_DRAG_TABLE", 1], "expect": [1.3498483821043403, -0.000004021455125370997, 2699.3935553594056, -0.016085218298670424, -8.236033838301988e-7, -0.0032942671834768947] },

    { "name": "findZeroAngle: .308 168gr G1 .462 @2700fps, 100yd zero, 1.5in scope", "fn": "findZeroAngle", "args": [{ "muzzleVelocity": 2700, "bc": 0.462, "dragTable": "$G1_DRAG_TABLE", "zeroRange": 100, "scopeHeight": 1.5, "speedOfSound": "$speedOfSoundStd", "airDensityRatio": 1 }], "expect": 0.06311659230449566 },

